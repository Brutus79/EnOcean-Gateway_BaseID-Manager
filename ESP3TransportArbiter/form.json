{
  "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
  "elements": [
    {
      "type": "Label",
      "caption": "ESP3 Transport Arbiter: Read-only-Wartung ist standardmäßig deaktiviert. Isolierter Modus blockiert native Sendetelegramme."
    },
    {
      "type": "CheckBox",
      "name": "IsolatedReadOnly",
      "caption": "Isolierter Read-only-Transport (keine native Automation)",
      "enabled": false
    },
    {
      "type": "CheckBox",
      "name": "EnableMaintenance",
      "caption": "Enable read-only maintenance API"
    },
    {
      "type": "NumberSpinner",
      "name": "MaximumQueueItems",
      "caption": "Maximum queued items",
      "minimum": 1,
      "maximum": 256
    },
    {
      "type": "NumberSpinner",
      "name": "MaximumQueueBytes",
      "caption": "Maximum queued bytes",
      "minimum": 1024,
      "maximum": 1048576
    },
    {
      "type": "NumberSpinner",
      "name": "MaintenanceTimeoutMs",
      "caption": "Maintenance response timeout",
      "minimum": 100,
      "maximum": 5000,
      "suffix": " ms"
    },
    {
      "type": "NumberSpinner",
      "name": "LateResponseGuardMs",
      "caption": "Late response quarantine",
      "minimum": 0,
      "maximum": 5000,
      "suffix": " ms"
    }
  ],
  "actions": [
    {
      "type": "TestCenter"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Parent transport active"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "No active parent transport"
    }
  ]
}
